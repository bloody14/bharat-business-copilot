APP_ENV=development
DATABASE_URL=postgresql+psycopg://bharat:bharat_local_dev@localhost:5432/bharat_copilot
# Must be a JSON array. Do not use wildcard '*'.
FRONTEND_ORIGINS='["http://localhost:3000", "https://bharat-copilot.vercel.app"]'
# Clerk: Dashboard → Configure → JWT Templates. Create a template named `bharat-api`
# with audience `bharat-business-copilot` and Organization claims enabled (`org_id`, `org_role`).
# Copy the Issuer URL from Configure → API Keys; never commit real values.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional; leave empty for Clerk's normal v2 session token, which has no aud claim.
CLERK_AUDIENCE=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter Settings (Phase 5B Fallback Provider)
# Set to an OpenRouter API key to enable fallback if Gemini quota is exhausted
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="openrouter/free"

# Copilot Settings
COPILOT_HISTORY_LIMIT=20
GEMINI_COOLDOWN_SECONDS=300
